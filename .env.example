# Copy to .env and adjust for your machine: cp .env.example .env

# local | test | staging | production
ENVIRONMENT=local
LOG_LEVEL=INFO

API_HOST=127.0.0.1
API_PORT=8000

# Required. Ports match docker-compose.yml (non-default to avoid clashing with other projects).
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:55432/agent_runtime
REDIS_URL=redis://localhost:56379/0
